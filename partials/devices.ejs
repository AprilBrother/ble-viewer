    <a class="list-group-item list-group-item-action flex-column align-items-start" data-toggle="collapse" href="#collapse<%=mid%>" role="button" aria-expanded="false" aria-controls="collapse<%=mid%>">
        <div class="d-flex w-100 justify-content-between">
          <h5 class="mb-1"> MAC: <%=mac%></h5>
          <small><%=cnt%> datas</small>
        </div>
        <p class="mb-1">MessageID: <%=mid%> IP: <%=ip%> Firmware: <%=v%> Time: <%=time%></p>

        <div class="collapse" id="collapse<%=mid%>">
          <div class="card card-body text-dark">
            <% devices.forEach(function(d){ %>
                <div class="d-flex align-items-baseline mb-1">
                  <% if (d.type !== '') { %>
                  <span class="badge badge-info flex-shrink-0 mr-2" style="width: 2rem;"><%= d.type %></span>
                  <% } %>
                  <span class="text-monospace font-weight-bold text-primary bg-light border rounded px-2 flex-shrink-0 mr-2" style="width: 12rem;"><%= d.mac %></span>
                  <% if (d.uuid) { %>
                  <span class="badge badge-light border text-monospace flex-shrink-0 mr-2"><%= d.uuid %></span>
                  <% } %>
                  <% if (d.rssi !== '') { %>
                  <span class="badge badge-secondary flex-shrink-0 mr-2" style="width: 3.5rem;"><%= d.rssi %></span>
                  <% } %>
                  <span class="text-monospace small text-muted"><%= d.text %></span>
                </div>
            <% }) %>
          </div>
        </div>
    </a>

